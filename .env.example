# Server
# PostgreSQL connection format:
# postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
# Example below uses username "postgres" and password "postgres".
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lumi?schema=public"
JWT_SECRET="lumi-secret-key"
JWT_EXPIRES_IN="30d"
SERVER_PORT=3000
WEB_ORIGIN="http://localhost:5173"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123456"

# Redis
# You can set username/password/database in REDIS_URL:
# - redis://localhost:6379/0
# - redis://:password@localhost:6379/0
# - redis://username:password@localhost:6379/0
# URL-encode special characters in username/password, for example "#" as "%23".
REDIS_URL="redis://localhost:6379/0"

INGEST_JOB_ATTEMPTS=3
AI_JOB_ATTEMPTS=2
JOB_BACKOFF_DELAY_MS=5000

# Web
VITE_API_BASE_URL="http://127.0.0.1:3000/api"

# Object storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="lumi"
S3_ACCESS_KEY_ID="lumi"
S3_SECRET_ACCESS_KEY="lumi-password"

# AI
AI_PROVIDER="deepseek"
AI_OUTPUT_LANGUAGE="zh-CN"
# Used to encrypt AI API keys stored from the Web settings page.
# Must be at least 32 characters, or exactly 64 hex characters.
# Keep this value stable after saving API keys.
AI_CONFIG_ENCRYPTION_KEY="change-me-at-least-32-characters-long"

DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

SILICONFLOW_API_KEY=""
SILICONFLOW_BASE_URL="https://api.siliconflow.cn/v1"
SILICONFLOW_MODEL=""
