# 服务端
# PostgreSQL 连接格式：
# postgresql://<用户名>:<密码>@<主机>:<端口>/<数据库>?schema=public
# 下面的示例使用用户名 "postgres" 和密码 "postgres"。
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lumi?schema=public"
JWT_SECRET="lumi-secret-key"
JWT_EXPIRES_IN="30d"
# 设为 "false" 可关闭公开注册（POST /api/auth/register）。
AUTH_REGISTER_ENABLED="true"
SERVER_PORT=3000
# CORS 允许的来源；多个来源用英文逗号分隔。
# Capacitor/移动 WebView 默认源（https://localhost 等）始终放行。
WEB_ORIGIN="http://localhost:5173"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123456"

# Redis
# 可以在 REDIS_URL 中指定用户名/密码/数据库：
# - redis://localhost:6379/0
# - redis://:password@localhost:6379/0
# - redis://username:password@localhost:6379/0
# 用户名/密码中的特殊字符需要 URL 编码，例如 "#" 写作 "%23"。
REDIS_URL="redis://localhost:6379/0"

# 异步队列任务（BullMQ）
# 导入任务（URL/HTML 抓取解析、视频字幕拉取）最大尝试次数
INGEST_JOB_ATTEMPTS=3
# AI 分析任务（阅读卡/视频总结生成）最大尝试次数
AI_JOB_ATTEMPTS=2
# Embedding 索引任务（知识库向量索引）最大尝试次数
EMBEDDING_JOB_ATTEMPTS=2
# 任务失败后的指数退避初始延迟（毫秒），后续按指数递增
JOB_BACKOFF_DELAY_MS=5000

# 视频导入（MVP9，B站）
# 从已登录浏览器导出的 Netscape 格式 cookies.txt；拉取 AI 字幕必需。
# 文件包含登录凭据，切勿提交到仓库（secrets/ 已被 gitignore）。
# Cookie 过期后重新导出并替换同路径下的文件。
BILI_COOKIE_FILE=""
# yt-dlp 可执行文件路径；默认从 PATH 中解析 "yt-dlp"。
YT_DLP_PATH=""
# 允许导入的最大视频时长（分钟），超过则快速失败。
VIDEO_MAX_DURATION_MINUTES=60
# 单次视频总结的字幕字符量上限（不超过该值时跳过 Map-Reduce 分块，整篇进上下文；
# 超限或单次失败自动回退 Map-Reduce）。
VIDEO_SINGLE_PASS_MAX_CHARS=16000

# 日志
# 日志级别：error / warn / info / debug（默认 info）
LOG_LEVEL="info"
# 日志目录，留空使用仓库根目录下的 logs
LOG_DIR=""

# Web
VITE_API_BASE_URL="http://127.0.0.1:3000/api"

# 对象存储（RustFS / S3 兼容）
# 桶需要手动创建并配置公开读。
# 任一必填项为空时，URL/HTML 导入保留原图地址。
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_PUBLIC_BASE_URL=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# AI
AI_PROVIDER="deepseek"
AI_OUTPUT_LANGUAGE="zh-CN"
# 用于加密 Web 设置页保存的 AI API Key。
# 长度至少 32 个字符，或恰好 64 位十六进制字符。
# 保存 API Key 后请保持该值不变。
AI_CONFIG_ENCRYPTION_KEY="change-me-at-least-32-characters-long"

DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

SILICONFLOW_API_KEY=""
SILICONFLOW_BASE_URL="https://api.siliconflow.cn/v1"
SILICONFLOW_MODEL=""
